---
layout: layouts/base.njk
---
{%- set svcIcons = {"residential": "home", "deep": "deep", "move": "door", "post_construction": "hardhat", "commercial": "building"} -%}
<section class="page-hero"><div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/service-areas/">Service Areas</a> <span>/</span> {{ title }}</nav>
  <span class="eyebrow light">{{ county }} County</span>
  <h1>Cleaning services in {{ title }}.</h1>
  <p>{{ intro }}</p>
  <div class="hero-actions"><a class="btn btn-primary btn-lg" href="/contact/">Request a Free Quote {% icon "arrow" %}</a></div>
</div></section>
<section class="block"><div class="wrap prose-wrap">
  <div class="prose">{{ content | safe }}</div>
  <div>
    <h2 class="other-title">Services in {{ title }}</h2>
    <div class="other-grid one-col">
      {%- for svc in collections.services %}{% if not services or svc.data.form_key in services %}
      <a class="other" href="{{ svc.url }}"><span class="icon">{% icon svcIcons[svc.data.form_key] %}</span><b>{{ svc.data.title }}</b>{% icon "arrow", "go" %}</a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</div></section>
{% include "partials/quote-card.njk" %}
